---
import { Image } from "astro:assets";

const { product } = Astro.props;
const { id, name, price, images } = product.data;
---

<li class="product-card grid-xs">
  <Image
    src={images[0]}
    alt={name}
    height={320}
    width={320}
  />
  <h2>{name}</h2>
  <p>{"_PRICE_"}</p>
  <a href={`/product/${id}`} class="btn">View More</a>
</li>
